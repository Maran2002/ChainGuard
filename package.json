{
  "name": "chainguard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm --workspace @chainguard/web run dev",
    "dev:api": "npm --workspace @chainguard/api run dev",
    "build": "npm --workspace @chainguard/web run build",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "ingest": "npm --workspace @chainguard/api run ingest --",
    "seed:admin": "npm --workspace @chainguard/api run seed:admin"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "next": "^16.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
