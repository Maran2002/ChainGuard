# Public browser settings for local development
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# API settings. See the README for Vercel settings and required values.
API_PREFIX=/api/v1
APP_NAME=ChainGuard
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/chainguard
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=
BREVO_API_KEY=
JWT_ACCESS_SECRET=replace_with_random_secret_at_least_32_bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_bytes
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12
BLOCKCHAIN_PROVIDER_MODE=unavailable
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_DEVELOPMENT_MAX_REQUESTS=1000
LOG_LEVEL=info
TRON_RPC_URL=
TRON_API_KEY=
TRONSCAN_API_KEY=
ETHEREUM_RPC_URL=
ETHEREUM_API_KEY=
BSC_RPC_URL=
BSC_API_KEY=
NODEREAL_API_KEY=
INTELLIGENCE_INGESTION_ENABLED=false
INTELLIGENCE_SOURCE_TIMEOUT_MS=15000
